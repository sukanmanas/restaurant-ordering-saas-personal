-- =====================================================
-- STEP 2: Run this after setup.sql
-- Creates Krua Pa Toi restaurant
-- =====================================================
DO $$
DECLARE
  v_restaurant_id UUID;
BEGIN
  INSERT INTO restaurants (name, slug, phone, email, city, restaurant_type, status, is_active, subscription_plan)
  VALUES (
    'Krua Pa Toi',
    'krua-pa-toi',
    '0000000000',
    'owner@kruapatoi.local',
    'Bangkok',
    'restaurant',
    'active',
    TRUE,
    'pro'
  )
  RETURNING id INTO v_restaurant_id;

  INSERT INTO users (restaurant_id, email, password_hash, temp_password, role)
  VALUES (
    v_restaurant_id,
    'owner@kruapatoi.local',
    encode(digest('krua1234', 'sha256'), 'hex'),
    FALSE,
    'owner'
  );
END $$;


-- =====================================================
-- STEP 3: Run this after Step 2
-- Opens up RLS policies for single-restaurant personal app
-- =====================================================
DROP POLICY IF EXISTS "Restaurant owners can view their restaurant" ON restaurants;
DROP POLICY IF EXISTS "Restaurant owners can update their restaurant" ON restaurants;
DROP POLICY IF EXISTS "Restaurant owners can manage menu" ON menu_items;
DROP POLICY IF EXISTS "Restaurant owners can manage orders" ON orders;

CREATE POLICY "Anon can view restaurants" ON restaurants FOR SELECT USING (true);
CREATE POLICY "Anon can update restaurants" ON restaurants FOR UPDATE USING (true);
CREATE POLICY "Anon can manage menu items" ON menu_items FOR ALL USING (true);
CREATE POLICY "Anon can manage orders" ON orders FOR ALL USING (true);
CREATE POLICY "Anon can manage menu categories" ON menu_categories FOR ALL USING (true);
